{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["shared", "server", "client", "vite.config.ts"],
  // Cloudflare's runtime, not the DOM nor Bun: checked by tsconfig.worker.json.
  "exclude": ["server/worker.ts"]
}
